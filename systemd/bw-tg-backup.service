[Unit]
Description=Encrypted Bitwarden backup to Telegram
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/bw-tg-backup --config /etc/bw-tg-backup.conf
TimeoutStartSec=infinity
# SIGTERM goes to the script first, so its trap can restart Bitwarden.
KillMode=mixed
TimeoutStopSec=30min
PrivateTmp=true
Nice=10
